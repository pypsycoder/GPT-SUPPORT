# ─────────────────────────────────────────────────────────────────────────────
#  GPT Health Support — пример окружения.
#  Скопируйте в .env и подставьте реальные значения. .env в git не коммитим.
# ─────────────────────────────────────────────────────────────────────────────

# --- Базовое -----------------------------------------------------------------
ENVIRONMENT=dev                     # dev | test | prod
# APP_NAME=GPT Health Support
# ENV_FILE=.env                     # переопределить путь к файлу окружения

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hemo_db

# --- Telegram-бот ----------------------------------------------------------- -
BOT_TOKEN=000000000:PUT-YOUR-BOT-TOKEN-HERE

# --- Проактивный планировщик ----------------------------------------------- -
# OFF по умолчанию. true → в lifespan app/main.py стартует APScheduler:
# проактивный координатор в 08:00 / 14:00 / 20:00 МСК (собирает поводы от всех
# подсистем, единый потолок 2/день, дедуп в llm.proactive_deliveries).
# Тот же флаг требует и запасной процесс `python -m app.llm.worker`.
# Двойного запуска не будет: оба пути берут один advisory-lock.
SCHEDULER_ENABLED=false
# Идентификатор advisory-lock (pg_try_advisory_lock). Менять только если он
# конфликтует с другим приложением на той же БД.
# SCHEDULER_LOCK_ID=4815162342

# --- Семантический детектор суицидального риска (второй эшелон) ------------- -
# OFF по умолчанию. true → после L0-regex подключается kNN по эмбеддингам.
# Включать после прогона safety-bench / patient-sim.
LLM_CRISIS_SEMANTIC=false
# CRISIS_SEMANTIC_THRESHOLD=0.70    # порог косинусной близости к кризисному кластеру
# CRISIS_SEMANTIC_MARGIN=0.03       # запас над ближайшим НЕ-кризисным прототипом

# --- GigaChat (аккаунты Сбербанка, base64-encoded credential) ------------- -
GIGACHAT_KEY_A1=PUT-BASE64-CREDENTIAL-HERE     # → GigaChat-2-Lite
# GIGACHAT_KEY_A2=<base64_credential_account_2>  # → GigaChat-2-Pro
# GIGACHAT_KEY_A3=<base64_credential_account_3>
# GIGACHAT_MODEL_A3=max            # lite | pro | max (по умолчанию pro)
# GIGACHAT_CERT_PATH=/path/to/russian_trusted_root_ca.pem   # иначе verify=False

# --- Прочие LLM-провайдеры (patient-sim, вспомогательное) ----------------- -
# OPENROUTER_API_KEY=sk-or-v1-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- Рейт-лимит чата ------------------------------------------------------- -
# In-process скользящее окно на пациента для POST /api/chat/message.
# CHAT_RATE_LIMIT_MAX=20            # запросов в окне; 0 = выключить
# CHAT_RATE_LIMIT_WINDOW_SEC=60

# --- Флаги разработки ----------------------------------------------------- -
# LLM_DEBUG=false                   # true → лог промптов/ответов эксперта
# CSRF_ENABLED=false
